  "item": [
    {
      "name": "1. Administrator Authentication",
      "item": [
        {
          "name": "1.1 Request OTP (Configured Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Response indicates eligible request and returns challengeId\", function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data).to.have.property(\"challengeId\");",
                  "    pm.collectionVariables.set(\"challengeId\", jsonData.data.challengeId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\"\n}"
            },
            "url": "http://{{baseUrl}}/api/v1/auth/admin/request-otp"
          }
        },
        {
          "name": "1.2 Request OTP (Unknown Email)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"unauthorized-user@example.com\"\n}"
            },
            "url": "http://{{baseUrl}}/api/v1/auth/admin/request-otp"
          }
        },
        {
          "name": "1.3 Verify OTP and Receive JWT + Cookie",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Admin auth successful and accessToken captured\", function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.role).to.eql(\"ADMIN\");",
                  "    pm.expect(jsonData.data).to.have.property(\"accessToken\");",
                  "    pm.collectionVariables.set(\"accessToken\", jsonData.data.accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\",\n  \"email\": \"{{adminEmail}}\",\n  \"otp\": \"123456\"\n}"
            },
            "url": "http://{{baseUrl}}/api/v1/auth/admin/verify-otp"
          }
        },
        {
          "name": "1.4 Logout Administrator",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{accessToken}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [],
            "url": "http://{{baseUrl}}/api/v1/auth/admin/logout"
          }
        }
